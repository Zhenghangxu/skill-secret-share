{
  "name": "@skillspore/rendezvous-worker",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --name skillspore-rendezvous-staging",
    "deploy:production": "wrangler deploy --name skillspore-rendezvous"
  },
  "dependencies": {
    "@skillspore/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "wrangler": "^4.120.0"
  }
}
