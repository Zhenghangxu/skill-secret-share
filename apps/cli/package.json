{
  "name": "skillspore",
  "version": "0.1.0-beta.1",
  "description": "Securely share and install Agent Skills peer to peer",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skillspore": "./bin/skillspore.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --external:@clack/prompts --external:@scure/bip39 --external:@secretlint/node --external:@secretlint/secretlint-rule-preset-recommend --external:diff --external:picocolors --external:xdg-basedir --external:yaml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@scure/bip39": "^2.0.1",
    "@secretlint/node": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "diff": "^8.0.2",
    "picocolors": "^1.1.1",
    "xdg-basedir": "^5.1.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
